{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build:vercel",
  "crons": [
    {
      "path": "/api/cron/followup",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/guest-messages",
      "schedule": "30 3 * * *"
    }
  ]
}
